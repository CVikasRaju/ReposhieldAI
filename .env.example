# RepoShield AI configuration. Copy to .env only if you want to override defaults.
RS_WORKSPACE=./workspace
RS_POLICY_PATH=./.aishield
RS_DATA_DIR=./data
# RS_PROFILE=developer
RS_MCP_HOST=127.0.0.1
RS_MCP_PORT=8001
# Comma-separated Host headers the MCP listener accepts. Needed in Docker where
# the agent reaches it as gateway:8001; unset keeps localhost only.
# RS_MCP_ALLOWED_HOSTS=gateway:8001,gateway,127.0.0.1:8001,localhost:8001
RS_API_HOST=127.0.0.1
RS_API_PORT=8000
# Leave empty to generate a token at startup.
RS_APPROVER_TOKEN=
RS_LOG_LEVEL=INFO
