# RepoShield agent sandbox: an MCP client and nothing else.
#
# It contains no gateway code, no policy and no workspace. The only network it
# can reach is the internal agent_net (the gateway), and its root filesystem is
# read-only with every capability dropped by docker-compose.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin agent

WORKDIR /app

# Only the MCP client dependency tree: no FastAPI, no database drivers, no
# gateway package.
RUN pip install --no-cache-dir "mcp>=1.2,<2.0"

COPY --chown=agent:agent demo/simulated_agent.py ./simulated_agent.py
COPY --chown=agent:agent scripts/verify_isolation.py ./scripts/verify_isolation.py

USER agent

# The sandbox idles; run the demo on demand:
#   docker compose exec -T agent python simulated_agent.py --mcp http://gateway:8001/mcp
CMD ["sleep", "infinity"]
